{
  "name": "codeyoung-trial-booking",
  "version": "1.0.0",
  "private": true,
  "description": "Codeyoung Trial Class Appointment Booking System",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "setup": "npm run prisma:generate --workspace=backend && npm run prisma:migrate:deploy --workspace=backend && npm run prisma:seed --workspace=backend && npm run build",
    "dev": "npm run dev:all",
    "dev:all": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "start": "concurrently \"npm run start --workspace=backend\" \"npm run preview --workspace=frontend\"",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=backend",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace=backend",
    "prisma:seed": "npm run prisma:seed --workspace=backend",
    "prisma:reset": "npm run prisma:reset --workspace=backend",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
